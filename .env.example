# This file documents which secret goes WHERE. Most of them are not read
# from a local .env at all — Edge Functions read Supabase secrets, and n8n
# reads its own credential store.

# --- Supabase Edge Function secrets ---------------------------------------
# Set in: Dashboard -> Project Settings -> Edge Functions -> Secrets.
# NOT a local .env, and NOT the project API-keys page.
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected automatically —
# you only add the third-party ones.
ANTHROPIC_API_KEY=      # copilot reasoning (claude-opus-5). REQUIRED.
OPENAI_API_KEY=         # /transcribe only (gpt-4o-transcribe). Not built yet.

# --- n8n credential store (agent call workflow) ---------------------------
ELEVENLABS_API_KEY=
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=

# --- Backend -> n8n dispatch ----------------------------------------------
# Set as a Supabase Edge Function secret once /tasks/:id/run exists.
N8N_WEBHOOK_URL=

# --- Frontend (Vercel env vars) -------------------------------------------
# The anon/publishable key is designed to be public — safe in the browser.
# The service role key is NOT: never ship it to the frontend.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Note: the Supabase MCP server (.mcp.json) uses OAuth — no token to store.
# Authenticate with `/mcp` in a regular terminal.
