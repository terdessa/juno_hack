# This file documents which secret goes WHERE. Almost none of them are read
# from a local .env — the Edge Functions read Supabase secrets, and that is the
# only place most of these matter.

# --- Supabase Edge Function secrets ---------------------------------------
# Set in: Dashboard -> Project Settings -> Edge Functions -> Secrets,
# or `supabase secrets set NAME=value --project-ref <ref>`.
# NOT a local .env, and NOT the project API-keys page.
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected automatically —
# you only add the third-party ones.

ANTHROPIC_API_KEY=      # /agent and /copilot reasoning, /call-webhook extraction. REQUIRED.
ELEVENLABS_API_KEY=     # /tasks-run and /tasks-due place calls; /speak and
                        # /transcribe are the dashboard's voice. REQUIRED.

# Which agent answers and which number it dials from. In the handoff notes;
# separate from the key so the call track can swap agents without a redeploy.
ELEVENLABS_AGENT_ID=
ELEVENLABS_PHONE_NUMBER_ID=

# Signs the post-call webhook. Copy it out of ElevenLabs when you create the
# webhook (Settings -> Webhooks). Without it /call-webhook accepts unsigned
# deliveries and logs a warning — fine for invented records, not for real ones.
ELEVENLABS_WEBHOOK_SECRET=

# OPENAI_API_KEY is no longer needed. Transcription moved to ElevenLabs Scribe,
# which uses the key above — a second speech vendor bought nothing.

# --- Frontend (Vercel env vars) -------------------------------------------
# The anon/publishable key is designed to be public — safe in the browser.
# The service role key is NOT: never ship it to the frontend.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Gone -----------------------------------------------------------------
# N8N_WEBHOOK_URL: dropped. The backend calls ElevenLabs directly now, so
# there is no workflow tool in the middle to hold credentials.
# GOOGLE_CALENDAR_*: calendar booking is still a stretch goal, unbuilt.
